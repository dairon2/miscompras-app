# ===================================
# DESARROLLO LOCAL - MISCOMPRAS
# ===================================

# ==== DATABASE (LOCAL) ====
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/miscompras_dev"

# ==== EMAILS DESHABILITADOS ====
DISABLE_EMAILS=true

# ==== JWT ====
JWT_SECRET=dev_secret_change_in_production

# ==== FRONTEND URL ====
FRONTEND_URL=http://localhost:3000

# ==== BLOB STORAGE (Opcional para desarrollo) ====
# Descomenta si quieres usar Blob Storage en desarrollo
# AZURE_STORAGE_CONNECTION_STRING=...
# AZURE_STORAGE_CONTAINER=pdfs

# ==== EMAIL SERVICE (No necesario con DISABLE_EMAILS=true) ====
# AZURE_COMMUNICATION_CONNECTION_STRING=...
# SENDER_EMAIL=...
