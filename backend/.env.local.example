# ===================================
# DESARROLLO LOCAL - MISCOMPRAS
# ===================================
# Copia este archivo a .env.local para desarrollo local
# cp .env.local.example .env.local

# ==== DATABASE ====
# Opción 1: Usar la misma BD de producción (CUIDADO)
# DATABASE_URL="postgresql://usuario:password@miscomprasdb.postgres.database.azure.com:5432/miscompras?sslmode=require"

# Opción 2: PostgreSQL local (RECOMENDADO para desarrollo)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/miscompras_dev"

# ==== EMAILS ====
# Deshabilitar emails en desarrollo (MUY RECOMENDADO)
DISABLE_EMAILS=true

# ==== JWT ====
JWT_SECRET=dev_secret_change_in_production

# ==== FRONTEND URL ====
FRONTEND_URL=http://localhost:3000

# ==== BLOB STORAGE (Opcional) ====
# Descomenta si quieres usar el mismo storage en desarrollo
# AZURE_STORAGE_CONNECTION_STRING=...
# AZURE_STORAGE_CONTAINER=pdfs

# ==== EMAIL SERVICE (No necesario si DISABLE_EMAILS=true) ====
# AZURE_COMMUNICATION_CONNECTION_STRING=...
# SENDER_EMAIL=...

# ==== NOTES ====
# Para desarrollo local:
# 1. Instala PostgreSQL localmente
# 2. Crea una base de datos: createdb miscompras_dev
# 3. Ejecuta: npx prisma db push
# 4. Ejecuta: npm run dev
