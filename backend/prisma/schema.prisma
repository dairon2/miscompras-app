generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String
  name                   String?
  role                   Role                    @default(USER)
  invoiceValidationScope InvoiceValidationScope?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  areaId                 String?
  lastLoginAt            DateTime?
  mustChangePassword     Boolean                 @default(false)
  passwordResetExpires   DateTime?
  passwordResetToken     String?
  refreshToken           String?
  refreshTokenExpires    DateTime?
  isActive               Boolean                 @default(true)
  phone                  String?
  position               String?
  profilePhoto           String?
  areasDirected          Area[]                  @relation("AreaDirector")
  budgetsApproved        Budget[]                @relation("BudgetApprovedBy")
  budgetsCreated         Budget[]                @relation("BudgetCreatedBy")
  managedBudgets         Budget[]                @relation("BudgetManager")
  adjustmentsRequested   BudgetAdjustment[]      @relation("AdjustmentRequestedBy")
  adjustmentsReviewed    BudgetAdjustment[]      @relation("AdjustmentReviewedBy")
  budgetGroups           BudgetGroup[]           @relation("BudgetGroupCreator")
  budgetSubLeader        BudgetSubLeader[]
  invoicesCreated        Invoice[]               @relation("InvoiceCreator")
  invoicesLed            Invoice[]               @relation("InvoiceLeaderResponsible")
  suppliersClassified    Supplier[]              @relation("SupplierManagementClassifiedBy")
  advancesRequested      Advance[]               @relation("AdvanceRequestedBy")
  advancesApproved       Advance[]               @relation("AdvanceApprovedBy")
  advancesDisbursed      Advance[]               @relation("AdvanceDisbursedBy")
  advancesLegalized      Advance[]               @relation("AdvanceLegalizedBy")
  projectsLed            Project[]               @relation("ProjectLeader")
  requirementsCreated    Requirement[]           @relation("CreatedBy")
  requirementsOwned      Requirement[]           @relation("OwnedBy")
  groupsCreated          RequirementGroup[]      @relation("GroupCreator")
  projectsSubLed         Project[]               @relation("ProjectSubLeader")
  area                   Area?                   @relation("AreaUsers", fields: [areaId], references: [id])
}

model Project {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  leaderId     String?
  subLeaderId  String?
  funder       String?
  budgets      Budget[]
  leader       User?         @relation("ProjectLeader", fields: [leaderId], references: [id])
  subLeader    User?         @relation("ProjectSubLeader", fields: [subLeaderId], references: [id])
  requirements Requirement[]
  advances     Advance[]
}

model Area {
  id                 String        @id @default(uuid())
  name               String        @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  directorId         String?
  commercialInvoices Invoice[]     @relation("InvoiceCommercialArea")
  advances           Advance[]
  director           User?         @relation("AreaDirector", fields: [directorId], references: [id])
  budgets            Budget[]
  requirements       Requirement[]
  users              User[]        @relation("AreaUsers")
}

model Supplier {
  id                       String             @id @default(uuid())
  name                     String
  taxId                    String?            @unique
  contactEmail             String?
  contactPhone             String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  address                  String?
  contactName              String?
  email                    String?
  nit                      String?            @unique
  phone                    String?
  criticality              Criticality        @default(LOW)
  supplierType             SupplierType       @default(SUPPLIER)
  activity                 String?
  management               SupplierManagement @default(UNCLASSIFIED)
  managementSource         String?
  managementClassifiedAt   DateTime?
  managementClassifiedById String?
  managementClassifiedBy   User?              @relation("SupplierManagementClassifiedBy", fields: [managementClassifiedById], references: [id], onDelete: SetNull)
  invoices                 Invoice[]
  advances                 Advance[]
  requirements             Requirement[]
  ratings                  SupplierRating[]

  @@index([management])
  @@index([managementClassifiedById])
}

model SupplierRating {
  id             String      @id @default(uuid())
  supplierId     String
  requirementId  String      @unique
  overallRating  Int
  deliveryRating Int
  qualityRating  Int
  priceRating    Int
  comment        String?
  evaluatedById  String
  createdAt      DateTime    @default(now())
  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  supplier       Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  budgets     Budget[]
}

model Budget {
  id                String             @id @default(uuid())
  amount            Decimal            @db.Decimal(15, 2)
  available         Decimal            @db.Decimal(15, 2)
  categoryId        String
  projectId         String
  areaId            String
  managerId         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  approvedAt        DateTime?
  approvedById      String?
  code              String?
  createdById       String?
  description       String?
  documentUrl       String?
  status            BudgetStatus       @default(PENDING)
  title             String
  version           Int                @default(1)
  year              Int                @default(2026)
  expirationDate    DateTime?
  groupId           Int?
  adjustmentSources AdjustmentSource[]
  approvedBy        User?              @relation("BudgetApprovedBy", fields: [approvedById], references: [id])
  area              Area               @relation(fields: [areaId], references: [id])
  category          Category           @relation(fields: [categoryId], references: [id])
  createdBy         User?              @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  group             BudgetGroup?       @relation(fields: [groupId], references: [id])
  manager           User?              @relation("BudgetManager", fields: [managerId], references: [id])
  project           Project            @relation(fields: [projectId], references: [id])
  adjustments       BudgetAdjustment[]
  invoices          Invoice[]          @relation("InvoiceBudget")
  advances          Advance[]
  subLeaders        BudgetSubLeader[]
  requirements      Requirement[]
}

model BudgetGroup {
  id        Int      @id @default(autoincrement())
  creatorId String
  createdAt DateTime @default(now())
  budgets   Budget[]
  creator   User     @relation("BudgetGroupCreator", fields: [creatorId], references: [id])
}

model BudgetSubLeader {
  id        String   @id @default(uuid())
  budgetId  String
  userId    String
  createdAt DateTime @default(now())
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([budgetId, userId])
}

model BudgetAdjustment {
  id              String             @id @default(uuid())
  code            String?            @unique
  type            AdjustmentType
  budgetId        String
  requestedAmount Decimal            @db.Decimal(15, 2)
  reason          String
  status          AdjustmentStatus   @default(PENDING)
  documentUrl     String?
  requestedById   String
  requestedAt     DateTime           @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  reviewComment   String?
  sources         AdjustmentSource[]
  budget          Budget             @relation(fields: [budgetId], references: [id])
  requestedBy     User               @relation("AdjustmentRequestedBy", fields: [requestedById], references: [id])
  reviewedBy      User?              @relation("AdjustmentReviewedBy", fields: [reviewedById], references: [id])
}

model AdjustmentSource {
  id           String           @id @default(uuid())
  adjustmentId String
  budgetId     String
  amount       Decimal          @db.Decimal(15, 2)
  adjustment   BudgetAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  budget       Budget           @relation(fields: [budgetId], references: [id])
}

model Requirement {
  id                     String              @id @default(uuid())
  title                  String
  description            String?
  quantity               String?
  estimatedAmount        Decimal?            @db.Decimal(15, 2)
  actualAmount           Decimal?            @db.Decimal(15, 2)
  status                 Status              @default(PENDING_APPROVAL)
  procurementStatus      ProcurementStatus   @default(PENDIENTE)
  projectId              String
  areaId                 String
  supplierId             String?
  manualSupplierName     String?
  createdById            String
  currentOwnerId         String?
  budgetId               String?
  purchaseOrderNumber    String?
  invoiceNumber          String?
  deliveryDate           DateTime?
  receivedAtSatisfaction Boolean             @default(false)
  satisfactionComments   String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  hasMultiplePayments    Boolean             @default(false)
  isAsiento              Boolean             @default(false)
  reqCategory            RequirementCategory @default(ORDEN_COMPRA)
  totalAmount            Decimal?            @db.Decimal(15, 2)
  year                   Int                 @default(2026)
  coordinatorApproval    Boolean?
  coordinatorComment     String?
  directorApproval       Boolean?
  directorComment        String?
  groupId                Int?
  leaderApproval         Boolean?
  leaderComment          String?
  receivedDate           DateTime?
  suggestedSupplier      String?
  purchaseComments       String?
  attachments            Attachment[]
  logs                   HistoryLog[]
  invoices               Invoice[]
  advances               Advance[]
  payments               Payment[]
  area                   Area                @relation(fields: [areaId], references: [id])
  budget                 Budget?             @relation(fields: [budgetId], references: [id])
  createdBy              User                @relation("CreatedBy", fields: [createdById], references: [id])
  currentOwner           User?               @relation("OwnedBy", fields: [currentOwnerId], references: [id])
  group                  RequirementGroup?   @relation(fields: [groupId], references: [id])
  project                Project             @relation(fields: [projectId], references: [id])
  supplier               Supplier?           @relation(fields: [supplierId], references: [id])
  supplierRating         SupplierRating?
}

model RequirementGroup {
  id           Int           @id @default(autoincrement())
  creatorId    String
  pdfUrl       String?
  createdAt    DateTime      @default(now())
  requirements Requirement[]
  creator      User          @relation("GroupCreator", fields: [creatorId], references: [id])
}

model Attachment {
  id            String      @id @default(uuid())
  fileName      String
  fileUrl       String
  requirementId String
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])
}

model HistoryLog {
  id            String      @id @default(uuid())
  action        String
  details       String?
  requirementId String
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])
}

model Notification {
  id            String   @id @default(uuid())
  title         String
  message       String
  type          String   @default("INFO")
  isRead        Boolean  @default(false)
  userId        String
  requirementId String?
  createdAt     DateTime @default(now())
}

model Payment {
  id            String      @id @default(uuid())
  paymentNumber Int
  amount        Decimal     @db.Decimal(15, 2)
  invoiceNumber String?
  paymentDate   DateTime?
  observations  String?
  requirementId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  purchaseOrder String?
  invoiceId     String?
  invoice       Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model SystemConfig {
  id                    String   @id @default("main")
  activeYear            Int      @default(2026)
  appName               String   @default("MisCompras")
  isRegistrationEnabled Boolean  @default(true)
  maintenanceMode       Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model Invoice {
  id                       String              @id @default(uuid())
  invoiceNumber            String
  supplierId               String
  requirementId            String?
  amount                   Decimal             @db.Decimal(15, 2)
  issueDate                DateTime
  dueDate                  DateTime?
  status                   InvoiceStatus       @default(RECEIVED)
  fileUrl                  String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  createdById              String
  verifiedAt               DateTime?
  verifiedById             String?
  approvedAt               DateTime?
  approvedById             String?
  paidAt                   DateTime?
  paidById                 String?
  transactionNumber        String?
  purchaseOrderNumber      String?
  budgetId                 String?
  observations             String?
  causationNumber          String?
  causationDate            DateTime?
  leaderApproval           Boolean?
  subtotal                 Decimal?            @db.Decimal(15, 2)
  taxAmount                Decimal?            @db.Decimal(15, 2)
  commercialAreaId         String?
  policyApproverName       String?
  policyReviewObservations String?
  causationObservations    String?
  requirementNumber        String?
  itemNumber               Int                 @default(autoincrement())
  passToArea               String?
  costCenterOrProject      String?
  purchaseObservations     String?
  commercialValidation     String?
  legalValidation          String?
  legalObservations        String?
  advanceId                String?
  advanceAmount            Decimal?            @db.Decimal(15, 2)
  leaderResponsibleId      String?
  attachments              InvoiceAttachment[]
  auditLogs                InvoiceAuditLog[]
  advance                  Advance?            @relation(fields: [advanceId], references: [id], onDelete: SetNull)
  budget                   Budget?             @relation("InvoiceBudget", fields: [budgetId], references: [id], onDelete: SetNull)
  commercialArea           Area?               @relation("InvoiceCommercialArea", fields: [commercialAreaId], references: [id], onDelete: SetNull)
  createdBy                User                @relation("InvoiceCreator", fields: [createdById], references: [id])
  leaderResponsible        User?               @relation("InvoiceLeaderResponsible", fields: [leaderResponsibleId], references: [id], onDelete: SetNull)
  payments                 Payment[]
  requirement              Requirement?        @relation(fields: [requirementId], references: [id])
  supplier                 Supplier            @relation(fields: [supplierId], references: [id])

  @@index([supplierId, invoiceNumber])
  @@index([requirementId])
  @@index([status])
  @@index([dueDate])
  @@index([paidAt])
  @@index([budgetId])
  @@index([commercialAreaId])
  @@index([causationNumber])
  @@index([purchaseOrderNumber])
  @@index([advanceId])
  @@index([leaderResponsibleId])
}

model InvoiceAttachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  invoiceId String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceAuditLog {
  id         String         @id @default(uuid())
  invoiceId  String?
  action     String
  fromStatus InvoiceStatus?
  toStatus   InvoiceStatus?
  details    String?
  actorId    String?
  actorEmail String?
  createdAt  DateTime       @default(now())
  invoice    Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([action])
  @@index([createdAt])
}

model AdvanceSequence {
  year            Int      @id
  nextConsecutive Int
  updatedAt       DateTime @updatedAt
}

model Advance {
  id                  String                 @id @default(uuid())
  consecutive         Int
  year                Int
  requestDate         DateTime               @default(now())
  beneficiaryType     AdvanceBeneficiaryType @default(SUPPLIER)
  beneficiaryDocument String
  beneficiaryName     String
  supplierId          String?
  costCenter          String?
  costCenterCode      String?
  purpose             String
  amount              Decimal                @db.Decimal(15, 2)
  status              AdvanceStatus          @default(REQUESTED)
  legalizationDueDate DateTime?
  legalizationNotes   String?
  requirementId       String?
  budgetId            String?
  projectId           String?
  areaId              String?
  requestedById       String
  approvedById        String?
  approvedAt          DateTime?
  disbursedById       String?
  disbursedAt         DateTime?
  legalizedById       String?
  legalizedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  supplier            Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requirement         Requirement?           @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  budget              Budget?                @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  project             Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  area                Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  requestedBy         User                   @relation("AdvanceRequestedBy", fields: [requestedById], references: [id])
  approvedBy          User?                  @relation("AdvanceApprovedBy", fields: [approvedById], references: [id])
  disbursedBy         User?                  @relation("AdvanceDisbursedBy", fields: [disbursedById], references: [id])
  legalizedBy         User?                  @relation("AdvanceLegalizedBy", fields: [legalizedById], references: [id])
  attachments         AdvanceAttachment[]
  auditLogs           AdvanceAuditLog[]
  invoices            Invoice[]

  @@unique([year, consecutive])
  @@index([status])
  @@index([beneficiaryDocument])
  @@index([supplierId])
  @@index([requirementId])
  @@index([requestDate])
}

model AdvanceAttachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  advanceId String
  createdAt DateTime @default(now())
  advance   Advance  @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([advanceId])
}

model AdvanceAuditLog {
  id         String         @id @default(uuid())
  advanceId  String
  action     String
  fromStatus AdvanceStatus?
  toStatus   AdvanceStatus?
  details    String?
  actorId    String?
  actorEmail String?
  createdAt  DateTime       @default(now())
  advance    Advance        @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([advanceId])
  @@index([createdAt])
}

model SubmissionRule {
  id            String   @id @default(uuid())
  name          String
  dayOfWeek     Int
  startTime     String
  endTime       String
  isHolidayRule Boolean  @default(false)
  holidayShift  Int?
  isActive      Boolean  @default(true)
  priority      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ColombianHoliday {
  id   String   @id @default(uuid())
  date DateTime @unique
  name String
  year Int
}

enum SupplierType {
  SUPPLIER
  SERVICE_PROVIDER
}

enum SupplierManagement {
  UNCLASSIFIED
  COMMERCIAL
  ADMINISTRATIVE_PURCHASING
  PAYROLL
  SHARED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

enum Role {
  USER
  LEADER
  DIRECTOR
  ADMIN
  COORDINATOR
  AUDITOR
  DEVELOPER
  INVOICE_VALIDATOR
}

enum InvoiceValidationScope {
  COMMERCIAL
  LEGAL
  ACCOUNTING
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdjustmentType {
  INCREASE
  TRANSFER
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Status {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ProcurementStatus {
  ANULADO
  ENTREGADO
  EN_TRAMITE
  PENDIENTE
  FINALIZADO
  POSTERGADO
  RECHAZADO
}

enum RequirementCategory {
  ANTICIPO
  COMPRA
  COMPRA_ONLINE
  CONTRATO
  ORDEN_COMPRA
  ORDEN_SERVICIO
  ORDEN_PRODUCCION
  SERVICIO
}

enum InvoiceStatus {
  RECEIVED
  VERIFIED
  APPROVED
  PAID
  REJECTED
}

enum AdvanceBeneficiaryType {
  SUPPLIER
  EMPLOYEE
}

enum AdvanceStatus {
  REQUESTED
  APPROVED
  DISBURSED
  LEGALIZED
  REJECTED
  CANCELLED
}
